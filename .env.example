DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csquared_cms
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
KEYCLOAK_CLIENT_ID=csquared-cms
KEYCLOAK_CLIENT_SECRET=replace-with-client-secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/csquared
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
RESEND_API_KEY=

# Email (Resend primary; Gmail app-password fallback for Google Workspace)
EMAIL_FROM=                # optional explicit From address
SMTP_USER=                 # Gmail/Workspace address used as SMTP sender (fallback)
APP_PASSWORD=              # Gmail app password for SMTP_USER (fallback)
TEST_EMAIL_RECIPIENT=      # dev only: redirect all outgoing mail here to avoid spamming

# Google Drive document storage (service account)
GOOGLE_SERVICE_ACCOUNT_KEY=   # full service-account JSON, single line
GDRIVE_SHARED_DRIVE_ID=       # ID of the private "Change Management" Shared Drive
GDRIVE_ROOT_FOLDER_ID=        # ID of the root folder inside that Shared Drive

# Shared secret for the SLA escalation cron endpoint (POST /api/cron/sla, header x-cron-secret)
CRON_SECRET=
