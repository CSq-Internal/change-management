# Copy to .env (which is gitignored) before running `docker compose up`.
# Values below are local-dev defaults — change them for any shared/non-local environment.

# Keycloak temporary bootstrap admin (used only to create the master-realm admin)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Postgres
POSTGRES_DB=csquared_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
